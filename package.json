{
  "name": "agent-workbench",
  "version": "0.1.0",
  "private": true,
  "description": "A generic local workbench for agent-first applications",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "npm run build:electron && concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build:electron": "tsc -p tsconfig.electron.json && node scripts/build-preload.mjs",
    "dev:renderer": "vite",
    "dev:electron": "wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.electron.json && node scripts/build-preload.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "lint": "eslint .",
    "start": "electron .",
    "qa:context-menus": "npm run build && node scripts/qa-context-menus.mjs",
    "qa:composer": "node scripts/qa-composer.mjs",
    "qa:commit-message": "npm run build && node scripts/qa-commit-message.mjs",
    "qa:confirm-dialogs": "npm run build && node scripts/qa-confirm-dialogs.mjs",
    "qa:resources": "npm run build && node scripts/qa-resources.mjs",
    "qa:ai-usage": "npm run build && node scripts/qa-ai-usage.mjs",
    "qa:source-control": "npm run build && node scripts/qa-source-control.mjs",
    "qa:send-selection": "npm run build && node scripts/qa-send-selection.mjs",
    "postinstall": "electron-rebuild -f -w node-pty",
    "dist": "npm run build && electron-builder --mac && npm run open:app",
    "dist:dir": "npm run build && electron-builder --mac --dir && npm run open:app",
    "open:app": "open \"release/mac-arm64/Agent Workbench.app\"",
    "release": "npm run build && node scripts/release.mjs",
    "qa:security": "npm run build && node scripts/qa-security.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/merge": "^6.12.3",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-serialize": "^0.13.0",
    "@xterm/headless": "^5.5.0",
    "@xterm/xterm": "^5.5.0",
    "node-pty": "^1.0.0",
    "react": "^19.1.1",
    "react-aria-components": "^1.12.1",
    "react-dom": "^19.1.1",
    "react-resizable-panels": "^2.1.9",
    "zod": "^4.1.5",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@electron/rebuild": "^4.0.1",
    "@eslint/js": "^9.35.0",
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "playwright": "^1.55.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0",
    "vite": "^7.1.5",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "dev.local.agent-workbench",
    "productName": "Agent Workbench",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**/*"
    ],
    "npmRebuild": true,
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "identity": "-",
      "hardenedRuntime": true
    },
    "afterPack": "scripts/harden-package.mjs"
  },
  "overrides": {
    "@electron/universal": {
      "minimatch": "^11.0.8"
    },
    "app-builder-lib": {
      "minimatch": "^11.0.8"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.8"
    }
  }
}
